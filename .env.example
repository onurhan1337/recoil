NODE_ENV=development
NEXT_PUBLIC_RESEND_FROM_EMAIL=test@test.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key

NEXT_PUBLIC_APP_URL=http://localhost:3000

CRON_SECRET=your_secure_random_string_for_cron_endpoints
RESEND_API_KEY=re_your_resend_api_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Polar.sh Subscription Integration
# IMPORTANT: These should be server-side only (no NEXT_PUBLIC_ prefix)
# Use an Organization Access Token (not Personal Access Token)
# Organization tokens automatically set the organization context
POLAR_ACCESS_TOKEN=your_polar_organization_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
POLAR_PRODUCT_PRICE_ID=your_polar_product_price_id

#debug token -> Verify debug access token for debug APIs
DEBUG_TOKEN=

# AI
AI_PROVIDER=auto
AI_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2